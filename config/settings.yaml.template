exchanges:
  ib:
    port: 4002
    client_id: 1
    account_id: "DA12345678"
  binance:
    testnet: true
  okx:
    testnet: true
  coinbase:
    testnet: true
  kraken:
    testnet: true
  kucoin:
    testnet: false   # set to testnet to gauge bot performance

data:
  sources:
    - name: "yfinance"
      enabled: true
  update_frequency:
    historical: "1d"
    intraday: "5m"

risk_management:
  max_capital_per_trade: 0.02
  max_portfolio_heat: 0.15
  daily_loss_limit: 0.05
  max_drawdown: 0.20
  volatility_stop_multiplier: 2.0
  max_net_exposure: 0.5
  max_gross_exposure: 2.5
  max_position_pct: 0.25
  per_symbol_multipliers:
    QBTS: 4.0
    OPTT: 4.5
  # EOD reporting and time-based caps (times in UTC)
  eod_report_utc_time: "20:55"   # 15:55 ET during daylight saving
  overnight_cap_utc_time: "19:50" # 15:50 ET during daylight saving
  weekend_flatten_utc_time: "19:50" # same time on Friday
  overnight_cap_threshold: 0.20   # reduce positions >20% NAV to 20%
  weekend_flatten_threshold: 0.25 # reduce positions >25% NAV to 15%
  weekend_flatten_target: 0.15.0

  risk_by_broker:
    kucoin:                           # tighter risk management for small balances
      max_gross_exposure: 5.0
      max_position_pct: 0.50
      max_net_exposure: 1.0
      max_drawdown: 0.99
      daily_loss_limit: 0.50

strategies:
  active:
    - name: "TrendFollowingLongOnly"
      type: "technical"
      enabled: true
    - name: "TrendFollowing"
      type: "technical"
      enabled: true
    - name: "MeanReversion"
      type: "technical"
      enabled: true
    - name: "TrendFollowingLS"
      type: "technical"
      enabled: true
    - name: "OpeningRangeBreakout"
      type: "technical"
      enabled: true
    - name: "VWAPReversion"
      type: "technical"
      enabled: true
    - name: "MACDCross"
      type: "technical"
      enabled: true
    - name: "ADXTrendFilter"
      type: "technical"
      enabled: true
    - name: "OBVDivergence"
      type: "technical"
      enabled: true
    - name: "AroonCross"
      type: "technical"
      enabled: true
    - name: "StochasticCross"
      type: "technical"
      enabled: true
    - name: "FibonacciRetracement"
      type: "technical"
      enabled: true
    - name: "IchimokuCloud"
      type: "technical"
      enabled: true
    - name: "Breakout"
      type: "technical"
      enabled: false
    - name: "SMA5813"
      type: "technical"
      enabled: true

  strategies_by_broker:
    kucoin:
      - name: "TrendFollowingLongOnly"
        type: "technical"
        enabled: true
      - name: "MeanReversion"
        type: "technical"
        enabled: true
      - name: "OpeningRangeBreakout"
        type: "technical"
        enabled: true
      - name: "VWAPReversion"
        type: "technical"
        enabled: true
      - name: "SMA5813"
        type: "technical"
        enabled: true

  parameters:
    trend_following:
      fast_ma: 50
      slow_ma: 200
      rsi_period: 14
      rsi_oversold: 30
      rsi_overbought: 70
    trend_following_long_only:
      fast_ma: 50
      slow_ma: 200
      rsi_period: 14
      rsi_oversold: 30
      rsi_overbought: 70
    mean_reversion:
      bb_period: 20
      bb_std: 2.0
      rsi_period: 14
      rsi_oversold: 30
      rsi_overbought: 70
    opening_range_breakout:
      volume_ratio_threshold: 1.5
    vwap_reversion:
      std_mult: 2.0
      rsi_period: 14
      rsi_low: 30
      rsi_high: 70
    breakout:
      period: 20
    trend_following_ls:
      fast_ma: 50
      slow_ma: 200
      rsi_period: 14
      rsi_oversold: 30
      rsi_overbought: 70
    macd_cross:
      fast: 12
      slow: 26
      signal: 9
    adx_trend_filter:
      period: 14
      adx_threshold: 20
    obv_divergence:
      lookback: 20
    aroon_cross:
      period: 25
    stochastic_cross:
      k_period: 14
      d_period: 3
      overbought: 80
      oversold: 20
    fibonacci_retracement:
      swing_lookback: 50
      volume_factor: 1.5
      sma_period: 50
    ichimoku_cloud:
      tenkan: 9
      kijun: 26
      senkou_b: 52
      chikou_shift: 26
    sma_5_8_13:
      fast_ma: 5
      mid_ma: 8
      slow_ma: 13
    intraday:
      trend_following:
        fast_ma: 20
        slow_ma: 50
        rsi_period: 14
        rsi_oversold: 30
        rsi_overbought: 70
      mean_reversion:
        bb_period: 12
        bb_std: 2.0
        rsi_period: 14
        rsi_oversold: 30
        rsi_overbought: 70
      trend_following_ls:
        fast_ma: 20
        slow_ma: 50
        rsi_period: 14
        rsi_oversold: 30
        rsi_overbought: 70

execution:
  paper_trading: false
  simulate_slippage: true
  slippage_percent: 0.0005
  simulate_commissions: true
  commission_per_share: 0.0
  commission_min: 0.0
  commission_max_pct: 0.0015
  short_availability_check: false
  simulate_partial_fills: false
  partial_fill_min_ratio: 0.8
  earnings_avoidance: true
  earnings_avoidance_days: 5

monitoring:
  email:
    enabled: true
  telegram:
    enabled: true
    bot_token: ""
    chat_id: ""   # add this in  .env
  discord:
    enabled: true
    webhook_url: "https://discord.com/api/webhooks/..."
  health_check_port: 8000

scanner:
  enabled: true                    # set to true to enable auto-scanning
  schedule: "daily"                 # daily or weekly
  time: "08:00"                     # UTC time to run
  universe: ["SP500"]                      # stocks to scan; if empty, uses ib symbol list
  criteria:
    min_price: 10.0
    max_price: 500.0
    min_avg_volume: 500000
    above_sma50: true
    rsi_min: 40
    rsi_max: 70
    min_volatility_ratio: 0.02
    max_volatility_ratio: 0.10
  crypto_criteria:

    min_volume_usdt: 5000000      # $5M daily
    min_age_days: 30              # listed for at least a month
  top_n: 10

rotation:
  enabled: true                     # automatically exit losing positions not in scanner list