exchanges:
  ib:
    port: 4002
    client_id: 1
    account_id: "DA12345678"
  binance:
    testnet: true
  okx:
    testnet: true
  coinbase:
    testnet: true
  kraken:
    testnet: true
  kucoin:
    testnet: false  # set to testnet to gauge bot performance

data:
  sources:
    - name: "yfinance"
      enabled: true
  update_frequency:
    historical: "1d"
    intraday: "5m"

risk_management:
  max_capital_per_trade: 0.02
  max_portfolio_heat: 0.15
  daily_loss_limit: 0.05
  max_drawdown: 0.20
  volatility_stop_multiplier: 2.0
  max_net_exposure: 0.5
  max_gross_exposure: 1.5
  max_position_pct: 0.20
  per_symbol_multipliers:
    QBTS: 4.0
    OPTT: 4.5

  risk_by_broker:
    kucoin:                               # tighter risk management for small balances 
      max_gross_exposure: 5.0
      max_position_pct: 0.50
      max_net_exposure: 1.0
      max_drawdown: 0.99
      daily_loss_limit: 0.50

strategies:
  active:
    - name: "TrendFollowingLongOnly"
      type: "technical"
      enabled: true
    - name: "TrendFollowing"
      type: "technical"
      enabled: true
    - name: "MeanReversion"
      type: "technical"
      enabled: true
    - name: "TrendFollowingLS"
      type: "technical"
      enabled: true
    - name: "OpeningRangeBreakout"
      type: "technical"
      enabled: true
    - name: "VWAPReversion"
      type: "technical"
      enabled: true
    - name: "Breakout"
      type: "technical"
      enabled: false

  strategies_by_broker:
    kucoin:
      - name: "TrendFollowingLongOnly"
        type: "technical"
        enabled: true
      - name: "MeanReversion"
        type: "technical"
        enabled: true
      - name: "OpeningRangeBreakout"
        type: "technical"
        enabled: true
      - name: "VWAPReversion"
        type: "technical"
        enabled: true

  parameters:
    trend_following:
      fast_ma: 50
      slow_ma: 200
      rsi_period: 14
      rsi_oversold: 30
      rsi_overbought: 70
    trend_following_long_only:
      fast_ma: 50
      slow_ma: 200
      rsi_period: 14
      rsi_oversold: 30
      rsi_overbought: 70
    mean_reversion:
      bb_period: 20
      bb_std: 2.0
      rsi_period: 14
      rsi_oversold: 30
      rsi_overbought: 70
    opening_range_breakout:
      volume_ratio_threshold: 1.5
    vwap_reversion:
      std_mult: 2.0
      rsi_period: 14
      rsi_low: 30
      rsi_high: 70
    breakout:
      period: 20
    trend_following_ls:
      fast_ma: 50
      slow_ma: 200
      rsi_period: 14
      rsi_oversold: 30
      rsi_overbought: 70
    intraday:
      trend_following:
        fast_ma: 20
        slow_ma: 50
        rsi_period: 14
        rsi_oversold: 30
        rsi_overbought: 70
      mean_reversion:
        bb_period: 12
        bb_std: 2.0
        rsi_period: 14
        rsi_oversold: 30
        rsi_overbought: 70
      trend_following_ls:
        fast_ma: 20
        slow_ma: 50
        rsi_period: 14
        rsi_oversold: 30
        rsi_overbought: 70

execution:
  paper_trading: false
  simulate_slippage: true
  slippage_percent: 0.0005
  simulate_commissions: true
  commission_per_share: 0.0
  commission_min: 0.0
  commission_max_pct: 0.0015
  short_availability_check: false
  simulate_partial_fills: false
  partial_fill_min_ratio: 0.8
  earnings_avoidance: true
  earnings_avoidance_days: 5

monitoring:
  email:
    enabled: true
  telegram:
    enabled: true
    bot_token: ""
    chat_id: ""  # add this in .env
  discord:
    enabled: true
    webhook_url: "https://discord.com/api/webhooks/..."
  health_check_port: 8000